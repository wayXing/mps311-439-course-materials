# Files regenerated by the Vercel build or used only by the separate Sites host.
dist/
.astro/
.sites-stage/
.sites-artifacts/

# Keep local credentials and assistant configuration out of deployment uploads.
.env
.env.*
AGENTS.md
CLAUDE.md
.openai/

# PDF handouts are intentionally hidden from the public course site.  Keeping
# them out of this Vercel deployment keeps the upload below the Hobby limit;
# the original course files remain in the local materials directory.
public/materials/**/*.pdf

# Local record of the last release (scripts/collect-release-changes.mjs).
.release-manifest.json
