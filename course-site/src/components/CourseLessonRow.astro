---
import { course, type CourseLesson, type ResourceKind } from '../data/course';
import { timetable } from '../data/timetable';
import { colabUrl, withBase } from '../lib/urls';
import ResourceIcon from './ResourceIcon.astro';

interface Props {
  lesson: CourseLesson;
}

const { lesson } = Astro.props;

const resource = (kind: ResourceKind) => lesson.resources.find((item) => item.kind === kind);
const lectureResources = [resource('guide'), resource('slides'), resource('notes'), resource('notebook')].filter(Boolean);
const practiceResources = [resource('worksheet'), resource('workbook'), resource('solution')].filter(Boolean);
const colabRepository = course.colab?.repository;
const colabBranch = course.colab?.branch;
const colabNotebookRoot = course.colab?.notebookRoot;
const resourceLabel = (kind: ResourceKind) => ({
  guide: 'Guide',
  slides: 'Slides',
  notes: 'Notes',
  notebook: 'Demo',
  workbook: 'Colab',
  worksheet: 'Lab',
  solution: 'Solution',
  pdf: 'PDF',
  data: 'Data',
})[kind];

// Dates let the home page mark the lesson in progress (see the script in index.astro).
const lessonNumber = Number(lesson.slug.match(/^lesson-(\d+)$/)?.[1]);
const dates = timetable.events.find((event) => event.lesson === lessonNumber);
const lessonPage = withBase(`course/${lesson.slug}/`);
---

<article
  class="course-row"
  data-lecture-date={dates?.lectureDate || undefined}
  data-lab-date={dates?.labDate || undefined}
>
  <div class="course-row-lesson">
    <span class="lesson-marker" aria-hidden="true"></span>
    <span>{lesson.label}</span>
    <span class="lesson-now" data-kind="lecture" hidden></span>
    <span class="lesson-now" data-kind="lab" hidden></span>
  </div>

  <div class="course-row-topic">
    <div class="topic-title">
      <a href={lessonPage}><strong>{lesson.shortTitle}</strong></a>
      <a class="all-files" href={lessonPage} aria-label={`All files for ${lesson.title}`}><ResourceIcon kind="all" size={12} />All files</a>
    </div>
    <span>{lesson.summary}</span>
  </div>

  <div class="course-row-resources course-row-lecture">
    <span class="column-label">Lecture</span>
    {lectureResources.length > 0
      ? lectureResources.map((item) => item && (
        <a
          class={`resource-link resource-${item.kind}`}
          href={item.kind === 'notebook' && colabRepository ? colabUrl(colabRepository, item.source, colabBranch, colabNotebookRoot) : withBase(item.href)}
          target={item.kind === 'notebook' && colabRepository ? '_blank' : undefined}
          rel={item.kind === 'notebook' && colabRepository ? 'noopener' : undefined}
        ><ResourceIcon kind={item.kind} size={13} />{resourceLabel(item.kind)}</a>
      ))
      : <span class="resource-empty">—</span>}
    {lesson.video && (
      <a
        class="resource-link resource-video"
        href={`https://www.youtube.com/watch?v=${lesson.video.youtubeId}${course.videoPlaylist ? `&list=${course.videoPlaylist}` : ''}`}
        target="_blank"
        rel="noopener"
      ><ResourceIcon kind="video" size={13} />Video</a>
    )}
  </div>

  <div class="course-row-resources course-row-practice">
    <span class="column-label">Practice</span>
    {practiceResources.length > 0
      ? practiceResources.map((item) => item && (
        <a
          class={`resource-link resource-${item.kind}`}
          href={item.kind === 'workbook' && colabRepository ? colabUrl(colabRepository, item.source, colabBranch, colabNotebookRoot) : withBase(item.href)}
          target={item.kind === 'workbook' && colabRepository ? '_blank' : undefined}
          rel={item.kind === 'workbook' && colabRepository ? 'noopener' : undefined}
        ><ResourceIcon kind={item.kind} size={13} />{resourceLabel(item.kind)}</a>
      ))
      : <span class="resource-empty">—</span>}
  </div>
</article>
