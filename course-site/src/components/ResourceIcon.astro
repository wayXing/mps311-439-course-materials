---
import {
  BookOpenText,
  CirclePlay,
  ClipboardCheck,
  Code,
  Database,
  FileDown,
  FileText,
  FlaskConical,
  FolderOpen,
  NotebookText,
  Presentation,
} from '@lucide/astro';
import type { ResourceKind } from '../data/course';

interface Props {
  kind: ResourceKind | 'all' | 'video';
  size?: number;
}

const { kind, size = 15 } = Astro.props;
const icons = {
  slides: Presentation,
  notes: NotebookText,
  notebook: Code,
  workbook: Code,
  worksheet: FlaskConical,
  solution: ClipboardCheck,
  pdf: FileDown,
  guide: BookOpenText,
  data: Database,
  all: FolderOpen,
  video: CirclePlay,
};
const Icon = icons[kind] ?? FileText;
---

<Icon size={size} stroke-width={1.8} aria-hidden="true" />
