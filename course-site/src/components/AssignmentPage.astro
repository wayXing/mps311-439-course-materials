---
import SiteLayout from '../layouts/SiteLayout.astro';
import { course } from '../data/course';
import { assignmentOne, assignmentTwo } from '../data/assignment';
interface Props { number: 1 | 2; }
const { number } = Astro.props;
const assignment = number === 1 ? assignmentOne : assignmentTwo;
import { withBase } from '../lib/urls';
const resources = withBase(`assignments/${number === 1 ? 'assignment-one' : 'assignment-two'}/`);
---
<SiteLayout title={`Assignment ${number} · ${course.code}`} description={`Assignment ${number} brief, data, deadline and Blackboard submission information.`}>
  <section class="assignment-page shell">
    <header class="assignment-heading">
      <span class="eyebrow">{course.academicYear} · MPS311 / MPS439</span>
      <nav class="assignment-tabs" aria-label="Choose assignment"><a href={withBase('assignment/')} aria-current={number === 1 ? 'page' : undefined}>Assignment 1</a><a href={withBase('assignment/2/')} aria-current={number === 2 ? 'page' : undefined}>Assignment 2</a></nav>
      <h1>Assignment {number}</h1>
      <p>{number === 1 ? 'California Housing Prices' : 'Handwritten Digit Recognition'}</p>
    </header>
    <section class="deadline-banner" aria-labelledby="deadline-heading">
      <div class="deadline-copy">
        <h2 id="deadline-heading">Submission deadline</h2>
        <time datetime={assignment.deadlineAt ?? assignment.deadlineDate}>{assignment.deadlineLabel} {assignment.deadlineAt && <strong>14:00</strong>}</time>
        <span class="timezone">{assignment.deadlineAt ? 'UK time · GMT' : 'Check Blackboard for the submission time.'}</span>
      </div>
      {assignment.deadlineAt && <div class="countdown" data-deadline={assignment.deadlineAt} role="timer" aria-label="Time remaining until submission deadline">
        <div><strong data-unit="days">—</strong><span>Days</span></div>
        <div><strong data-unit="hours">—</strong><span>Hours</span></div>
        <div><strong data-unit="minutes">—</strong><span>Minutes</span></div>
        <div><strong data-unit="seconds">—</strong><span>Seconds</span></div>
      </div>
      }
      <p class="deadline-ended" hidden>Deadline has passed</p>
    </section>
    <div class="assignment-grid">
      <article class="assignment-card brief-card">
        <span class="step">01 · Start here</span>
        <h2>Read the brief</h2>
        <p>{number === 1 ? 'Build and improve a model to predict California housing prices.' : 'Compare classifiers, explore PCA and train a neural network to recognise handwritten digits.'} Read the tasks and marking standard before you begin.</p>
        <a class="button button-primary" href={`${resources}brief.html`}>Open assignment brief <span aria-hidden="true">↗</span></a>
      </article>
      <article class="assignment-card data-card">
        <span class="step">02 · Get the files</span>
        <h2>Download the data</h2>
        {number === 1 ? <div class="data-links">
          <a href={`${resources}train.csv`} download><span>train.csv <small>500 blocks · training data</small></span><span aria-hidden="true">↓</span></a>
          <a href={`${resources}test.csv`} download><span>test.csv <small>2,000 blocks · final evaluation</small></span><span aria-hidden="true">↓</span></a>
          <a href={`${resources}full.csv`} download><span>full.csv <small>18,640 blocks · MPS439 options A / B</small></span><span aria-hidden="true">↓</span></a>
        </div> : <>
          <p>Load MNIST with the code in the brief. If the download fails, use this backup file.</p>
          <div class="data-links"><a href={`${resources}mnist.npz`} download><span>mnist.npz <small>60,000 training + 10,000 test images · 11 MB</small></span><span aria-hidden="true">↓</span></a></div>
        </>}
      </article>
      <article class="assignment-card submission-card">
        <span class="step">03 · Hand in</span>
        <h2>Submit on Blackboard</h2>
        <p>Upload these two files to the <strong>Assignment {number} submission area</strong> in Blackboard:</p>
        <ul><li>One PDF report</li><li>One notebook (.ipynb or .py)</li></ul>
        <div class="filename-note"><strong>Use your registration number only.</strong><p>For example: <code>123456789.pdf</code> and <code>123456789.ipynb</code>. No name, version number or “final”.</p></div>
        <p class="submission-footer">All submissions are made on Blackboard.</p>
      </article>
    </div>
  </section>
  <script>
    const timer = document.querySelector<HTMLElement>('[data-deadline]');
    if (timer?.dataset.deadline) {
      const deadline = Date.parse(timer.dataset.deadline);
      const units = ['days', 'hours', 'minutes', 'seconds'];
      const fields = units.map((unit) => timer.querySelector<HTMLElement>(`[data-unit="${unit}"]`));
      let interval: number | undefined;
      const update = () => {
        const total = Math.max(0, Math.ceil((deadline - Date.now()) / 1000));
        const values = [Math.floor(total / 86400), Math.floor(total % 86400 / 3600), Math.floor(total % 3600 / 60), total % 60];
        fields.forEach((field, index) => { if (field) field.textContent = String(values[index]).padStart(2, '0'); });
        if (total === 0) {
          timer.hidden = true;
          const ended = document.querySelector<HTMLElement>('.deadline-ended');
          if (ended) ended.hidden = false;
          window.clearInterval(interval);
          return false;
        }
        return true;
      };
      if (update()) interval = window.setInterval(update, 1000);
    }
  </script>
</SiteLayout>
<style>
  .assignment-page { padding: 48px 0 80px; }
  .assignment-heading { margin-bottom: 28px; }
  .assignment-heading h1 { margin: 12px 0 8px; font-family: var(--font-display); font-size: clamp(42px, 6vw, 62px); font-weight: 500; letter-spacing: -0.04em; line-height: 1.1; }
  .assignment-heading p { margin: 0; color: var(--ink-soft); font-size: 21px; }
  .deadline-banner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; padding: 24px 28px; margin-bottom: 28px; background: #fff0df; border: 1px solid #e8bd8b; border-left: 5px solid #b94c0b; border-radius: 12px; color: #913a08; }
  .deadline-copy h2 { margin: 0 0 10px; font-size: 12px; text-transform: uppercase; letter-spacing: .08em; }
  .deadline-copy time { display: block; font-size: 21px; font-weight: 650; }
  .deadline-copy time strong { margin-left: 10px; }
  .timezone { display: block; margin-top: 7px; font-size: 12px; }
  .countdown { display: grid; grid-template-columns: repeat(4, minmax(48px,1fr)); gap: 18px; text-align: center; }
  .countdown[hidden], .deadline-ended[hidden] { display: none; }
  .countdown strong { display: block; font-size: 36px; line-height: 1.2; font-variant-numeric: tabular-nums; }
  .countdown span { display: block; margin-top: 5px; font-size: 11px; }
  .deadline-ended { font-size: 23px; font-weight: 700; }
  .assignment-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .assignment-card { background: var(--surface-solid); border: 1px solid var(--line); border-radius: 12px; padding: 28px; }
  .step { color: var(--ink-faint); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; font-weight: 700; }
  .assignment-card h2 { margin: 12px 0 16px; font-size: 23px; letter-spacing: -.02em; }
  .assignment-card p { color: var(--ink-soft); font-size: 14px; line-height: 1.65; }
  .brief-card .button { margin-top: 10px; }
  .data-links a { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 11px 0; border-top: 1px solid var(--line); font-size: 14px; font-weight: 650; }
  .data-links a:hover { color: var(--resource-data); }
  .data-links small { display: block; color: var(--ink-faint); font-size: 12px; font-weight: 400; margin-top: 4px; }
  .submission-card { grid-column: 1 / -1; }
  .submission-card ul { display: flex; flex-wrap: wrap; gap: 12px 32px; padding-left: 20px; font-size: 14px; }
  .filename-note strong, .filename-note p { color: #b00020; font-weight: 750; }
  .assignment-tabs { display: flex; gap: 8px; margin: 22px 0; }
  .assignment-tabs a { padding: 10px 16px; font-size: 13px; border: 1px solid var(--line); border-radius: 8px; }
  .assignment-tabs a[aria-current="page"] { color: white; background: var(--ink); }
  .assignment-tabs a:hover { border-color: var(--ink); }
  .filename-note { margin-top: 20px; padding: 16px 18px; background: var(--paper); border-radius: 8px; font-size: 14px; }
  .filename-note p { margin: 6px 0 0; }
  code { font-size: 12px; overflow-wrap: anywhere; }
  .submission-card .submission-footer { margin: 16px 0 0; font-size: 12px; }
  @media (max-width: 640px) { .assignment-page { padding: 32px 0 60px; } .assignment-grid { grid-template-columns: 1fr; gap: 16px; } .assignment-card { padding: 22px; } .deadline-banner { padding: 20px; gap: 20px; } .countdown { width: 100%; gap: 8px; } .countdown strong { font-size: 32px; } .deadline-copy time { font-size: 19px; } }
</style>
