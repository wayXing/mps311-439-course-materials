---
import { changelog } from '../data/changelog';
import { course } from '../data/course';
import SiteLayout from '../layouts/SiteLayout.astro';

const typeLabel = { improvement: 'Improvement', new: 'New', fix: 'Fix' };
const formatDate = (date: string) => new Intl.DateTimeFormat('en-GB', {
  day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
}).format(new Date(`${date}T12:00:00Z`));
---

<SiteLayout
  title={`Changelog · ${course.code}`}
  description={`Changes to the ${course.code} ${course.title} course materials.`}
>
  <section class="changelog-hero shell">
    <span class="eyebrow">{course.code} · {course.title}</span>
    <h1>Changelog</h1>
    {changelog.commitment.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  <section class="changelog-list shell" aria-label="Releases">
    {changelog.releases.map((release) => (
      <article class="changelog-release" id={`v${release.version}`}>
        <header>
          <h2>{release.title}</h2>
          <span class="release-meta">
            <time datetime={release.date}>{release.dateLabel ?? formatDate(release.date)}</time> · v{release.version}
          </span>
        </header>
        <ul>
          {release.items.map((item) => (
            <li>
              <span class:list={['change-tag', `change-${item.type}`]}>{typeLabel[item.type]}</span>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </section>
</SiteLayout>
