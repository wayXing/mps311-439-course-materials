---
import SiteLayout from '../layouts/SiteLayout.astro';
import { course } from '../data/course';
import { liveLessons, publishableKey, supabaseUrl as projectUrl } from '../data/live';
import '../styles/admin.css';

const submissionUrl = `${projectUrl}/functions/v1/course-feedback`;
const academicYearKey = course.academicYear.replace(/[^0-9]+/g, '-').replace(/^-|-$/g, '');
// Lesson titles and poll wording, written into each class report so it still reads years later.
const reportCourse = `${course.code} ${course.title}`;
const reportLessons = Object.fromEntries(liveLessons.map((lesson) => [lesson.slug, {
  label: lesson.label,
  title: lesson.title,
  polls: Object.fromEntries(lesson.polls.map((poll) => [poll.key, poll.slide])),
}]));
---

<SiteLayout title={`Feedback admin · ${course.code}`} description={`Private feedback administration for ${course.code}.`}>
  <section class="admin-page shell">
    <header class="admin-heading">
      <span class="eyebrow">Instructor only</span>
      <h1>Feedback administration</h1>
      <p>Browse anonymous suggestions and public questions, then manage the academic years available to students.</p>
    </header>

    <section class="admin-login admin-card" id="admin-login" aria-labelledby="admin-login-heading">
      <h2 id="admin-login-heading">Enter admin password</h2>
      <form id="admin-login-form" class="admin-login-form">
        <label for="admin-password">Password</label>
        <input id="admin-password" name="password" type="password" inputmode="numeric" autocomplete="current-password" required />
        <button type="submit">Enter</button>
      </form>
      <p class="admin-status" id="admin-login-status" aria-live="polite"></p>
    </section>

    <div class="admin-dashboard" id="admin-dashboard" hidden>
      <section class="admin-card admin-records" aria-labelledby="admin-records-heading">
        <div class="admin-card-heading records-heading">
          <div>
            <span class="admin-kicker">Private instructor view</span>
            <h2 id="admin-records-heading">Records</h2>
          </div>
          <label class="admin-filter" for="admin-year-filter">
            <span>Show</span>
            <select id="admin-year-filter"><option value="">All years</option></select>
          </label>
        </div>
        <p class="admin-status" id="admin-dashboard-status" aria-live="polite"></p>

        <div class="admin-record-section">
          <div class="admin-section-label"><h3>Feedback</h3><span id="admin-feedback-count">—</span></div>
          <!-- Every submission, newest first; the class it was given for is kept as its label. -->
          <form class="fb-controls" id="fb-controls">
            <label><span>Class</span><select id="fb-class"><option value="">All classes</option></select></label>
            <label><span>When</span><select id="fb-when"><option value="">In and after class</option><option value="in">In class</option><option value="after">After class</option></select></label>
            <label><span>Module</span><select id="fb-module"><option value="">Both</option><option>MPS311</option><option>MPS439</option></select></label>
            <label><span>Programming</span><select id="fb-background"><option value="">Any</option><option value="new">Hardly at all</option><option value="some">A little</option><option value="confident">Comfortable</option></select></label>
            <label><span>Lost at</span><select id="fb-lost"><option value="">Anywhere</option></select></label>
            <label><span>Change useful</span><select id="fb-useful"><option value="">Any answer</option><option value="yes">Yes</option><option value="no">No</option><option value="na">N/A</option></select></label>
            <label><span>Sort</span><select id="fb-sort">
              <option value="newest">Newest first</option>
              <option value="oldest">Oldest first</option>
              <option value="difficulty">Difficulty, hardest first</option>
              <option value="pace">Pace, fastest first</option>
              <option value="class">Class</option>
              <option value="lost">Lost at</option>
              <option value="module">Module</option>
            </select></label>
            <label class="fb-check"><input type="checkbox" id="fb-comments" />Comments only</label>
            <label class="fb-check"><input type="checkbox" id="fb-latest" />Latest per student</label>
          </form>
          <div class="fb-stats" id="fb-stats"></div>
          <div class="admin-empty" id="admin-feedback-empty">Loading feedback…</div>
          <div class="admin-table-wrap fb-table" id="admin-feedback-wrap" hidden>
            <table>
              <thead><tr>
                <th><button type="button" data-sort="newest">When</button></th>
                <th><button type="button" data-sort="class">Class</button></th>
                <th><button type="button" data-sort="difficulty">Difficulty</button></th>
                <th><button type="button" data-sort="pace">Pace</button></th>
                <th><button type="button" data-sort="lost">Lost at</button></th>
                <th><button type="button" data-sort="module">Student</button></th>
                <th><button type="button" data-sort="useful">Change useful</button></th>
                <th>Comment</th>
              </tr></thead>
              <tbody id="admin-feedback-body"></tbody>
            </table>
          </div>
          <details class="fb-legacy" id="fb-legacy" hidden>
            <summary>Older feedback (1–10 sliders, before the live page) · <span id="fb-legacy-count"></span></summary>
            <div class="admin-table-wrap">
              <table>
                <thead><tr><th>Session</th><th>Ratings</th><th>Suggestion</th><th>Submitted</th></tr></thead>
                <tbody id="fb-legacy-body"></tbody>
              </table>
            </div>
          </details>
        </div>

        <div class="admin-record-section">
          <div class="admin-section-label"><h3>Class reports</h3><span id="admin-reports-count">—</span></div>
          <p class="admin-status">One report per class: the votes (every round), all feedback, Got it / Lost per 5 minutes and the questions posted during the class. Save them in <code>reviews/class-data/&lt;year&gt;/</code> for the lesson's retro.</p>
          <div class="admin-empty" id="admin-reports-empty">No classes yet.</div>
          <div class="admin-table-wrap" id="admin-reports-wrap" hidden>
            <table>
              <thead><tr><th>Class</th><th>First started</th><th>Download</th></tr></thead>
              <tbody id="admin-reports-body"></tbody>
            </table>
          </div>
        </div>

        <div class="admin-record-section">
          <div class="admin-section-label"><h3>Like and Lost during class</h3><span id="admin-likes-count">—</span></div>
          <div class="admin-empty" id="admin-likes-empty">No likes yet.</div>
          <div class="admin-table-wrap" id="admin-likes-wrap" hidden>
            <table>
              <thead><tr><th>Class</th><th>Total</th><th>Per 5 minutes from the start</th></tr></thead>
              <tbody id="admin-likes-body"></tbody>
            </table>
          </div>
        </div>

        <div class="admin-record-section">
          <div class="admin-section-label"><h3>Classroom posts</h3><span id="admin-question-count">—</span></div>
          <div class="admin-empty" id="admin-questions-empty">Loading questions…</div>
          <div class="admin-table-wrap" id="admin-questions-wrap" hidden>
            <table>
              <thead><tr><th>Board</th><th>Name</th><th>Post</th><th>Status</th><th>Posted</th><th>Actions</th></tr></thead>
              <tbody id="admin-questions-body"></tbody>
            </table>
          </div>
        </div>
        <div class="admin-record-section">
          <div class="admin-section-label"><h3>Classroom replies</h3><span id="admin-reply-count">—</span></div>
          <div class="admin-empty" id="admin-replies-empty">Loading replies…</div>
          <div class="admin-table-wrap" id="admin-replies-wrap" hidden>
            <table>
              <thead><tr><th>Board</th><th>Name</th><th>Reply</th><th>Status</th><th>Posted</th><th>Actions</th></tr></thead>
              <tbody id="admin-replies-body"></tbody>
            </table>
          </div>
        </div>
      </section>
      <section class="admin-card admin-boards" aria-labelledby="admin-boards-heading">
        <div class="admin-card-heading">
          <div>
            <span class="admin-kicker">Classroom controls</span>
            <h2 id="admin-boards-heading">Question board</h2>
          </div>
        </div>
        <p class="admin-note">The current academic year's classroom board stays open. You can archive it here when needed; reopening an archived board also archives any other live board.</p>
        <form id="admin-board-form" class="admin-board-form">
          <label><span>Academic year</span><select id="admin-board-year" required></select></label>
          <button type="submit">Reopen board</button>
          <button type="button" class="admin-toggle" id="admin-archive-board">Archive live board</button>
        </form>
        <p class="admin-status" id="admin-board-status" aria-live="polite"></p>
        <div class="admin-boards-list" id="admin-boards-list"></div>
      </section>

      <section class="admin-card admin-years" aria-labelledby="admin-years-heading">
        <div class="admin-card-heading">
          <div>
            <span class="admin-kicker">Student selector</span>
            <h2 id="admin-years-heading">Academic years</h2>
          </div>
          <form id="admin-year-form" class="admin-year-form">
            <label class="sr-only" for="admin-year-input">New academic-year name</label>
            <input id="admin-year-input" name="year" maxlength="80" placeholder="2026 Summer School" required />
            <button type="submit">Add option</button>
          </form>
        </div>
        <p class="admin-note">Hide keeps a year and its records in this dashboard, but removes it from the student selector. Remove deletes only the year option; records are still kept.</p>
        <div id="admin-years-list" class="admin-years-list" aria-live="polite"></div>
      </section>

    </div>
  </section>

  <script is:inline define:vars={{ submissionUrl, publishableKey, academicYearKey, projectUrl, reportLessons, reportCourse }}>
    const tokenStorageKey = 'mps-course-feedback-admin-token-v1';
    const loginPanel = document.querySelector('#admin-login');
    const dashboard = document.querySelector('#admin-dashboard');
    const loginForm = document.querySelector('#admin-login-form');
    const loginStatus = document.querySelector('#admin-login-status');
    const dashboardStatus = document.querySelector('#admin-dashboard-status');
    const yearForm = document.querySelector('#admin-year-form');
    const yearInput = document.querySelector('#admin-year-input');
    const yearList = document.querySelector('#admin-years-list');
    const yearFilter = document.querySelector('#admin-year-filter');
    const feedbackBody = document.querySelector('#admin-feedback-body');
    const feedbackEmpty = document.querySelector('#admin-feedback-empty');
    const feedbackWrap = document.querySelector('#admin-feedback-wrap');
    const feedbackCount = document.querySelector('#admin-feedback-count');
    const questionsBody = document.querySelector('#admin-questions-body');
    const questionsEmpty = document.querySelector('#admin-questions-empty');
    const questionsWrap = document.querySelector('#admin-questions-wrap');
    const questionsCount = document.querySelector('#admin-question-count');
    const repliesBody = document.querySelector('#admin-replies-body');
    const repliesEmpty = document.querySelector('#admin-replies-empty');
    const repliesWrap = document.querySelector('#admin-replies-wrap');
    const repliesCount = document.querySelector('#admin-reply-count');
    const boardForm = document.querySelector('#admin-board-form');
    const boardYear = document.querySelector('#admin-board-year');
    const archiveBoard = document.querySelector('#admin-archive-board');
    const boardStatus = document.querySelector('#admin-board-status');
    const boardsList = document.querySelector('#admin-boards-list');

    const readError = async (response, fallback) => {
      try {
        const body = await response.json();
        if (typeof body?.error === 'string') return body.error;
      } catch {}
      return fallback;
    };

    const getToken = () => sessionStorage.getItem(tokenStorageKey);
    const clearSession = () => {
      sessionStorage.removeItem(tokenStorageKey);
      dashboard.hidden = true;
      loginPanel.hidden = false;
    };

    const requestAdmin = async (action, payload = {}) => {
      const response = await fetch(submissionUrl, {
        method: 'POST',
        headers: { apikey: publishableKey, 'Content-Type': 'application/json' },
        body: JSON.stringify({ action, admin_token: getToken(), ...payload }),
      });
      if (response.status === 401) {
        clearSession();
        throw new Error('Your admin session has expired. Please sign in again.');
      }
      if (!response.ok) throw new Error(await readError(response, 'Could not complete this admin request.'));
      return response.json();
    };

    const formatDate = (value) => {
      const date = new Date(value);
      return Number.isNaN(date.getTime()) ? '—' : date.toLocaleString([], {
        year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit',
      });
    };

    const sessionLabel = (contextKey) => String(contextKey || '').replace(/^(\d{4}-\d{2})-/, '$1 · ').replaceAll('-', ' ');
    const createCell = (text, className = '') => {
      const cell = document.createElement('td');
      cell.textContent = text;
      if (className) cell.className = className;
      return cell;
    };

    // Feedback from before the live page: 1–10 sliders for difficulty, pace and content.
    const renderLegacyFeedback = (records) => {
      const body = document.querySelector('#fb-legacy-body');
      body.replaceChildren();
      document.querySelector('#fb-legacy').hidden = records.length === 0;
      document.querySelector('#fb-legacy-count').textContent = `${records.length} record${records.length === 1 ? '' : 's'}`;
      records.forEach((record) => {
        const row = document.createElement('tr');
        row.append(
          createCell(sessionLabel(record.contextKey)),
          createCell(`D ${record.difficulty} · P ${record.pace} · C ${record.contentAmount}`, 'ratings-cell'),
          createCell(record.comment || '—', 'message-cell'),
          createCell(formatDate(record.createdAt)),
        );
        body.append(row);
      });
    };

    // ------------------------------------------------------------ feedback, every submission
    // The class reports hold every submission (not only the latest per student), so the list is
    // built from them: one report per class of the selected year. S1, S2, … pair one student's
    // rows within a class.
    let feedbackRows = [];
    const fbClass = document.querySelector('#fb-class');
    const fbWhen = document.querySelector('#fb-when');
    const fbModule = document.querySelector('#fb-module');
    const fbBackground = document.querySelector('#fb-background');
    const fbLost = document.querySelector('#fb-lost');
    const fbUseful = document.querySelector('#fb-useful');
    const fbSort = document.querySelector('#fb-sort');
    const fbComments = document.querySelector('#fb-comments');
    const fbLatest = document.querySelector('#fb-latest');
    const fbStats = document.querySelector('#fb-stats');
    const backgrounds = { new: 'hardly at all', some: 'a little', confident: 'comfortable' };
    const difficultyNames = ['Much too easy', 'A bit easy', 'About right', 'A bit hard', 'Much too hard'];
    const paceNames = ['Much too slow', 'A bit slow', 'About right', 'A bit fast', 'Much too fast'];
    // Diverging: blue below "about right", gray at it, red above.
    const scaleColors = ['#3769cf', '#9db4ee', '#c9c6bd', '#ef9a86', '#cc513f'];
    const escapeHtml = (text) => String(text ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
    const lostLabel = (row) => row.lostAt || 'not answered';
    // "Was today's change useful?": yes, no, or N/A (null; the default when a class had no change).
    const usefulLabel = (row) => ({ yes: 'Yes', no: 'No' })[row.improvementUseful] ?? 'N/A';
    const usefulRank = (row) => ({ yes: 0, no: 1 })[row.improvementUseful] ?? 2;
    const classStarts = () => {
      const starts = new Map();
      liveSessions.forEach((entry) => {
        if (!starts.has(entry.context_key) || entry.opened_at < starts.get(entry.context_key)) starts.set(entry.context_key, entry.opened_at);
      });
      return starts;
    };
    const className = (contextKey) => {
      const [, , slug, kind] = contextKey.match(/^(\d{4}-\d{2})-(.+)-(lecture|lab)$/) ?? [null, '', contextKey, ''];
      return `${reportLessons[slug]?.label ?? slug}${kind ? ` ${kind}` : ''}`;
    };

    const loadFeedback = async () => {
      const year = yearFilter.value;
      const starts = classStarts();
      const contexts = [...starts.keys()].filter((key) => !year || key.startsWith(`${year}-`));
      const reports = await Promise.all(contexts.map((key) => requestAdmin('admin_class_report', { context_key: key })
        .then((result) => result.report).catch(() => null)));
      feedbackRows = reports.filter(Boolean).flatMap((report) => (report.feedback ?? []).map((row) => ({
        ...row, contextKey: report.contextKey, classStart: starts.get(report.contextKey) ?? '',
      })));
      const keep = (select, options) => {
        const value = select.value;
        select.replaceChildren(select.options[0], ...options.map(([key, label]) => new Option(label, key)));
        select.value = options.some(([key]) => key === value) ? value : '';
      };
      keep(fbClass, contexts.sort((a, b) => (starts.get(a) < starts.get(b) ? 1 : -1))
        .map((key) => [key, `${className(key)} · ${new Date(starts.get(key)).toLocaleDateString([], { day: 'numeric', month: 'short' })}`]));
      keep(fbLost, [...new Set(feedbackRows.map(lostLabel))].sort().map((key) => [key, key]));
    };

    const visibleFeedback = () => {
      let rows = feedbackRows.filter((row) => (!fbClass.value || row.contextKey === fbClass.value)
        && (!fbWhen.value || (fbWhen.value === 'in') === row.inClass)
        && (!fbModule.value || row.module === fbModule.value)
        && (!fbBackground.value || row.background === fbBackground.value)
        && (!fbLost.value || lostLabel(row) === fbLost.value)
        && (!fbUseful.value || (row.improvementUseful ?? 'na') === fbUseful.value)
        && (!fbComments.checked || row.comment));
      if (fbLatest.checked) {
        const latest = new Map();
        rows.forEach((row) => {
          const key = `${row.contextKey}|${row.student}|${row.inClass}`;
          if (!latest.has(key) || latest.get(key).at < row.at) latest.set(key, row);
        });
        rows = [...latest.values()];
      }
      const newest = (a, b) => (a.at < b.at ? 1 : a.at > b.at ? -1 : 0);
      const orders = {
        newest,
        oldest: (a, b) => -newest(a, b),
        difficulty: (a, b) => b.difficulty - a.difficulty || newest(a, b),
        pace: (a, b) => b.pace - a.pace || newest(a, b),
        class: (a, b) => (a.classStart < b.classStart ? 1 : a.classStart > b.classStart ? -1 : 0) || newest(a, b),
        lost: (a, b) => lostLabel(a).localeCompare(lostLabel(b)) || newest(a, b),
        module: (a, b) => String(a.module ?? '~').localeCompare(String(b.module ?? '~')) || newest(a, b),
        useful: (a, b) => usefulRank(a) - usefulRank(b) || newest(a, b),
      };
      return rows.sort(orders[fbSort.value] ?? newest);
    };

    // A 1–5 rating as five small cells with the chosen one filled.
    const scaleCell = (value, names, what) => {
      const cell = document.createElement('td');
      cell.className = 'fb-scale-cell';
      cell.innerHTML = `<span class="fb-scale" title="${what} ${value}/5: ${names[value - 1] ?? ''}">${[1, 2, 3, 4, 5]
        .map((step) => `<i${step === value ? ` style="background:${scaleColors[step - 1]}"` : ''}></i>`).join('')}</span><b>${value}</b>`;
      return cell;
    };

    const histogram = (title, rows, key, names) => {
      const counts = [1, 2, 3, 4, 5].map((step) => rows.filter((row) => row[key] === step).length);
      const max = Math.max(1, ...counts);
      const mean = rows.length ? (rows.reduce((sum, row) => sum + row[key], 0) / rows.length).toFixed(1) : '—';
      return `<figure class="fb-chart"><figcaption><b>${title}</b><span>mean ${mean} · 3 = about right</span></figcaption>
        <div class="fb-bars">${counts.map((count, index) => `<div class="fb-bar" title="${index + 1} · ${names[index]}: ${count} (${rows.length ? Math.round((100 * count) / rows.length) : 0}%)">
          <span class="fb-bar-value">${count}</span>
          <span class="fb-bar-fill" style="height:${(100 * count) / max}%;background:${scaleColors[index]}"></span>
          <span class="fb-bar-label">${index + 1}<small>${names[index].replace(/^(Much too|A bit) /, '')}</small></span>
        </div>`).join('')}</div></figure>`;
    };

    const lostChart = (rows) => {
      const counts = {};
      rows.forEach((row) => { counts[lostLabel(row)] = (counts[lostLabel(row)] ?? 0) + 1; });
      const entries = Object.entries(counts).sort((a, b) => b[1] - a[1]);
      const max = Math.max(1, ...entries.map(([, count]) => count));
      return `<figure class="fb-chart fb-chart-wide"><figcaption><b>First got lost at</b><span>${entries.length} parts</span></figcaption>
        <div class="fb-rows">${entries.map(([label, count]) => `<div class="fb-row${/^(followed everything|not answered)$/.test(label) ? ' is-quiet' : ''}" title="${escapeHtml(label)}: ${count} (${Math.round((100 * count) / rows.length)}%)">
          <span class="fb-row-label">${escapeHtml(label)}</span>
          <span class="fb-row-track"><span class="fb-row-fill" style="width:${(100 * count) / max}%"></span></span>
          <span class="fb-row-value">${count}</span>
        </div>`).join('')}</div></figure>`;
    };

    const usefulChart = (rows) => {
      const counts = [['Yes', '#507e61'], ['No', '#cc513f'], ['N/A', '#c9c6bd']].map(([label, color]) => [label, color, rows.filter((row) => usefulLabel(row) === label).length]);
      const max = Math.max(1, ...counts.map(([, , count]) => count));
      return `<figure class="fb-chart"><figcaption><b>Change useful?</b><span>N/A = no change</span></figcaption>
        <div class="fb-bars fb-bars-3">${counts.map(([label, color, count]) => `<div class="fb-bar" title="${label}: ${count} (${Math.round((100 * count) / rows.length)}%)">
          <span class="fb-bar-value">${count}</span>
          <span class="fb-bar-fill" style="height:${(100 * count) / max}%;background:${color}"></span>
          <span class="fb-bar-label">${label}</span>
        </div>`).join('')}</div></figure>`;
    };

    const renderFeedback = () => {
      const rows = visibleFeedback();
      const students = new Set(rows.map((row) => `${row.contextKey}|${row.student}`)).size;
      feedbackCount.textContent = `${rows.length} of ${feedbackRows.length} submissions · ${students} student${students === 1 ? '' : 's'} (per class)`;
      fbStats.innerHTML = rows.length
        ? histogram('Difficulty', rows, 'difficulty', difficultyNames) + histogram('Pace', rows, 'pace', paceNames) + lostChart(rows) + usefulChart(rows)
        : '';
      feedbackBody.replaceChildren();
      feedbackEmpty.hidden = rows.length > 0;
      feedbackWrap.hidden = rows.length === 0;
      feedbackEmpty.textContent = feedbackRows.length ? 'No feedback for this selection.' : 'No feedback yet.';
      document.querySelectorAll('.fb-table th button').forEach((button) => button.classList.toggle('is-sorted', button.dataset.sort === fbSort.value
        || (button.dataset.sort === 'newest' && fbSort.value === 'oldest')));
      rows.forEach((record) => {
        const row = document.createElement('tr');
        const when = createCell(new Date(record.at).toLocaleString([], { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }), 'fb-nowrap');
        const klass = createCell(className(record.contextKey), 'fb-nowrap');
        const tag = document.createElement('small');
        tag.className = `fb-tag${record.inClass ? '' : ' is-after'}`;
        tag.textContent = record.inClass ? 'in class' : 'after';
        klass.append(' ', tag);
        const who = createCell(`${record.module ?? '—'} · ${backgrounds[record.background] ?? '—'}`, 'fb-nowrap fb-faint');
        const student = document.createElement('small');
        student.textContent = ` ${record.student}`;
        who.append(student);
        row.append(when, klass,
          scaleCell(record.difficulty, difficultyNames, 'Difficulty'),
          scaleCell(record.pace, paceNames, 'Pace'),
          createCell(lostLabel(record), record.lostAt ? '' : 'fb-faint'),
          who,
          createCell(usefulLabel(record), record.improvementUseful ? '' : 'fb-faint'),
          createCell(record.comment || '', 'message-cell'));
        feedbackBody.append(row);
      });
    };

    [fbClass, fbWhen, fbModule, fbBackground, fbLost, fbUseful, fbSort, fbComments, fbLatest].forEach((control) => control.addEventListener('change', renderFeedback));
    document.querySelectorAll('.fb-table th button').forEach((button) => button.addEventListener('click', () => {
      fbSort.value = button.dataset.sort === 'newest' && fbSort.value === 'newest' ? 'oldest' : button.dataset.sort;
      renderFeedback();
    }));

    // Questions all go to one board; the class a question belongs to is the live class at the time it was posted.
    let liveSessions = [];
    const loadLiveSessions = async () => {
      try {
        const query = new URLSearchParams({ select: 'context_key,lesson_slug,kind,opened_at,closes_at,closed_at', order: 'opened_at.desc', limit: '500' });
        const response = await fetch(`${projectUrl}/rest/v1/course_live_sessions?${query}`, { headers: { apikey: publishableKey } });
        const rows = await response.json();
        liveSessions = Array.isArray(rows) ? rows : [];
      } catch { liveSessions = []; }
    };
    const classAt = (time, fallbackKey) => {
      // Only the year's single classroom board needs the time; older boards name their class.
      if (!/-classroom$/.test(fallbackKey ?? '')) return sessionLabel(fallbackKey);
      const moment = new Date(time).getTime();
      const match = liveSessions.find((entry) => new Date(entry.opened_at).getTime() <= moment
        && moment <= new Date(entry.closed_at ?? entry.closes_at).getTime());
      if (match) return `${match.lesson_slug.replace('lesson-', 'Lesson ')} ${match.kind}`;
      return liveSessions.length ? 'Between classes' : sessionLabel(fallbackKey);
    };

    const renderQuestions = (records) => {
      questionsBody.replaceChildren();
      questionsCount.textContent = `${records.length} record${records.length === 1 ? '' : 's'}`;
      questionsEmpty.hidden = records.length > 0;
      questionsWrap.hidden = records.length === 0;
      records.forEach((record) => {
        const row = document.createElement('tr');
        row.append(
          createCell(classAt(record.createdAt, record.contextKey)),
          createCell(record.displayName || 'Anonymous'),
          createCell(record.question || '—', 'message-cell'),
          createCell(`${record.isVisible ? 'Visible' : 'Hidden'} · ${record.isAnswered ? 'Discussed' : 'Open'} · ↑ ${record.voteCount || 0}`),
          createCell(formatDate(record.createdAt)),
        );
        const actions = document.createElement('td');
        const answered = document.createElement('button');
        answered.type = 'button';
        answered.className = 'admin-toggle';
        answered.textContent = record.isAnswered ? 'Reopen' : 'Discussed';
        answered.addEventListener('click', async () => {
          try {
            await requestAdmin('admin_set_question_answered', { question_id: record.id, is_answered: !record.isAnswered });
            await loadOverview(record.isAnswered ? 'Post reopened.' : 'Post marked discussed.');
          } catch (error) { dashboardStatus.textContent = error instanceof Error ? error.message : 'Could not update this question.'; }
        });
        const visibility = document.createElement('button');
        visibility.type = 'button';
        visibility.className = 'admin-toggle';
        visibility.textContent = record.isVisible ? 'Hide' : 'Show';
        visibility.addEventListener('click', async () => {
          try {
            await requestAdmin('admin_set_question_visibility', { question_id: record.id, is_visible: !record.isVisible });
            await loadOverview(record.isVisible ? 'Question hidden.' : 'Question shown.');
          } catch (error) { dashboardStatus.textContent = error instanceof Error ? error.message : 'Could not update this question.'; }
        });
        actions.append(answered, visibility);
        row.append(actions);
        questionsBody.append(row);
      });
      if (records.length === 0) questionsEmpty.textContent = 'No classroom posts for this selection.';
    };

    const renderReplies = (records) => {
      repliesBody.replaceChildren();
      repliesCount.textContent = `${records.length} record${records.length === 1 ? '' : 's'}`;
      repliesEmpty.hidden = records.length > 0;
      repliesWrap.hidden = records.length === 0;
      records.forEach((record) => {
        const row = document.createElement('tr');
        row.append(
          createCell(classAt(record.createdAt, record.contextKey)),
          createCell(record.displayName || 'Anonymous'),
          createCell(record.reply || '—', 'message-cell'),
          createCell(record.isVisible ? 'Visible' : 'Hidden'),
          createCell(formatDate(record.createdAt)),
        );
        const actions = document.createElement('td');
        const visibility = document.createElement('button');
        visibility.type = 'button'; visibility.className = 'admin-toggle';
        visibility.textContent = record.isVisible ? 'Hide' : 'Show';
        visibility.addEventListener('click', async () => {
          try {
            await requestAdmin('admin_set_reply_visibility', { reply_id: record.id, is_visible: !record.isVisible });
            await loadOverview(record.isVisible ? 'Reply hidden.' : 'Reply shown.');
          } catch (error) { dashboardStatus.textContent = error instanceof Error ? error.message : 'Could not update this reply.'; }
        });
        actions.append(visibility); row.append(actions); repliesBody.append(row);
      });
      if (records.length === 0) repliesEmpty.textContent = 'No classroom replies for this selection.';
    };

    const renderBoards = (boards, years) => {
      const selectedYear = boardYear.value || academicYearKey;
      boardYear.replaceChildren();
      years.forEach((year) => boardYear.append(new Option(year.label, year.key)));
      boardYear.value = [...boardYear.options].some((option) => option.value === selectedYear)
        ? selectedYear : years[0]?.key || academicYearKey;
      boardsList.replaceChildren();
      const live = boards.find((board) => board.status === 'live');
      archiveBoard.disabled = !live;
      if (boards.length === 0) {
        boardsList.textContent = 'No boards have been opened yet.';
        return;
      }
      boards.forEach((board) => {
        const row = document.createElement('div');
        row.className = `admin-board-row${board.status === 'live' ? ' is-live' : ''}`;
        const title = document.createElement('strong');
        title.textContent = sessionLabel(board.contextKey);
        const detail = document.createElement('span');
        detail.textContent = `${board.status === 'live' ? 'Live now' : 'Archived'} · ${board.questionCount || 0} questions`;
        row.append(title, detail);
        boardsList.append(row);
      });
    };

    const renderYears = (years) => {
      const previousValue = yearFilter.value;
      yearList.replaceChildren();
      yearFilter.replaceChildren(new Option('All years', ''));
      years.forEach((year) => {
        const row = document.createElement('div');
        row.className = 'admin-year-row';
        row.classList.toggle('is-hidden-option', !year.isVisible);
        const details = document.createElement('div');
        const name = document.createElement('strong');
        name.textContent = year.label;
        const counts = document.createElement('span');
        counts.textContent = `${year.isVisible ? 'Visible to students' : 'Hidden from students'} · ${year.feedbackCount} feedback · ${year.questionCount} questions`;
        details.append(name, counts);
        const actions = document.createElement('div');
        actions.className = 'admin-year-actions';
        const visibility = document.createElement('button');
        visibility.type = 'button';
        visibility.className = 'admin-toggle';
        visibility.textContent = year.isVisible ? 'Hide' : 'Show';
        visibility.addEventListener('click', async () => {
          const action = year.isVisible ? 'hide' : 'show';
          if (!window.confirm(`${action[0].toUpperCase()}${action.slice(1)} ${year.label} for students? Records will remain in this dashboard.`)) return;
          dashboardStatus.textContent = `${action[0].toUpperCase()}${action.slice(1)}ing academic-year option…`;
          try {
            await requestAdmin('admin_set_year_visibility', { year_key: year.key, is_visible: !year.isVisible });
            await loadOverview(`Academic-year option ${action === 'hide' ? 'hidden' : 'shown'}.`);
          } catch (error) {
            dashboardStatus.textContent = error instanceof Error ? error.message : 'Could not update the academic-year option.';
          }
        });
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'admin-remove';
        remove.textContent = 'Remove';
        remove.addEventListener('click', async () => {
          if (!window.confirm(`Remove ${year.label} from the student selector? Existing records will be kept.`)) return;
          dashboardStatus.textContent = 'Removing academic year…';
          try {
            await requestAdmin('admin_delete_year', { year_key: year.key });
            if (yearFilter.value === year.key) yearFilter.value = '';
            await loadOverview('Academic year removed from the selector.');
          } catch (error) {
            dashboardStatus.textContent = error instanceof Error ? error.message : 'Could not remove the academic year.';
          }
        });
        actions.append(visibility, remove);
        row.append(details, actions);
        yearList.append(row);
        yearFilter.append(new Option(year.label, year.key));
      });
      if ([...yearFilter.options].some((option) => option.value === previousValue)) yearFilter.value = previousValue;
    };

    // Likes per class: when in the class students pressed the like button.
    const renderLikes = (records) => {
      const body = document.querySelector('#admin-likes-body');
      body.replaceChildren();
      document.querySelector('#admin-likes-count').textContent = `${records.length} class${records.length === 1 ? '' : 'es'}`;
      document.querySelector('#admin-likes-empty').hidden = records.length > 0;
      document.querySelector('#admin-likes-wrap').hidden = records.length === 0;
      records.forEach((record) => {
        const row = document.createElement('tr');
        const steps = (record.perFiveMinutes ?? []).map((step) => `${step.minute}–${step.minute + 5} min: 👍 ${step.likes} · 🤔 ${step.lost}`).join('\n');
        row.append(
          createCell(`${sessionLabel(record.contextKey)} · ${formatDate(record.openedAt)}`),
          createCell(`👍 ${record.likes} · 🤔 ${record.lost}`),
          createCell(steps || '—', 'ratings-cell'),
        );
        body.append(row);
      });
    };

    // ------------------------------------------------------------ class reports
    const download = (name, text, type) => {
      const link = document.createElement('a');
      link.href = URL.createObjectURL(new Blob([text], { type }));
      link.download = name;
      link.click();
      setTimeout(() => URL.revokeObjectURL(link.href), 1000);
    };
    const share = (count, total) => (total ? `${count} (${Math.round((100 * count) / total)}%)` : '0');
    const fivePoints = ['1 much too easy/slow', '2 a bit easy/slow', '3 about right', '4 a bit hard/fast', '5 much too hard/fast'];

    const reportMarkdown = (report) => {
      const [, year, slug, kind] = report.contextKey.match(/^(\d{4}-\d{2})-(.+)-(lecture|lab)$/) ?? [null, '', report.contextKey, ''];
      const lesson = reportLessons[slug] ?? { label: slug, title: '', polls: {} };
      const lines = [];
      const when = (value) => new Date(value).toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' });
      lines.push(`# Class report: ${year.replace('-', '/')} · ${lesson.label} ${kind}${lesson.title ? `: ${lesson.title}` : ''}`, '');
      lines.push(`- Course: ${reportCourse}`);
      lines.push(`- Class key: \`${report.contextKey}\` (year, lesson, lecture or lab)`);
      lines.push(`- Sessions: ${report.sessions.map((entry) => `${when(entry.openedAt)} to ${new Date(entry.endedAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`).join('; ') || 'none'}`);
      lines.push(`- Report made: ${when(report.generatedAt)}`, '');

      lines.push('## Votes', '');
      if (!report.polls.length) lines.push('No votes.', '');
      report.polls.forEach((poll) => {
        lines.push(`### ${lesson.polls[poll.pollKey] ?? poll.pollKey}`, '', `“${poll.prompt}”`, '');
        if (poll.kind === 'choice') {
          const header = ['Option', ...poll.rounds.map((round) => `Round ${round.round}${round.round === poll.revealedRound ? ' (shown)' : ''}`)];
          lines.push(`| ${header.join(' | ')} |`, `|${header.map(() => '---').join('|')}|`);
          poll.options.forEach((option, index) => {
            lines.push(`| ${String.fromCharCode(65 + index)}. ${option} | ${poll.rounds.map((round) => share(round.counts[index], round.counts.reduce((sum, value) => sum + value, 0))).join(' | ')} |`);
          });
          lines.push(`| Votes | ${poll.rounds.map((round) => round.counts.reduce((sum, value) => sum + value, 0)).join(' | ')} |`, '');
        } else {
          (poll.answers ?? []).forEach((answer) => lines.push(`- ${answer.hidden ? '(hidden) ' : ''}${answer.body}`));
          lines.push('');
        }
      });

      const feedback = report.feedback;
      const students = new Set(feedback.map((row) => row.student));
      lines.push('## Feedback', '', `${feedback.length} submissions from ${students.size} students (latest per student counted below).`, '');
      // In class and after class; each also split by module (MPS311 and MPS439 share the room).
      const groups = [];
      ['In class', 'After class'].forEach((label) => {
        const latest = new Map();
        feedback.filter((row) => row.inClass === (label === 'In class')).forEach((row) => latest.set(row.student, row));
        const all = [...latest.values()];
        groups.push([label, all]);
        ['MPS311', 'MPS439'].forEach((module) => {
          const part = all.filter((row) => row.module === module);
          if (part.length && part.length < all.length) groups.push([`${label}, ${module}`, part]);
        });
      });
      groups.forEach(([label, rows]) => {
        if (!rows.length) return;
        lines.push(`### ${label} (${rows.length} students)`, '');
        lines.push('| Point | Difficulty | Pace |', '|---|---|---|');
        fivePoints.forEach((name, index) => {
          lines.push(`| ${name} | ${share(rows.filter((row) => row.difficulty === index + 1).length, rows.length)} | ${share(rows.filter((row) => row.pace === index + 1).length, rows.length)} |`);
        });
        const lost = {};
        rows.forEach((row) => { const key = row.lostAt || 'not answered'; lost[key] = (lost[key] ?? 0) + 1; });
        lines.push('', 'First got lost at:', ...Object.entries(lost).sort((a, b) => b[1] - a[1]).map(([key, count]) => `- ${key}: ${count}`), '');
        const useful = (value) => rows.filter((row) => (row.improvementUseful ?? null) === value).length;
        lines.push(`Today's change useful? Yes ${useful('yes')} · No ${useful('no')} · N/A ${useful(null)}`, '');
        const comments = rows.filter((row) => row.comment);
        if (comments.length) lines.push('Comments:', ...comments.map((row) => `- ${row.student}: ${row.comment}`), '');
      });

      lines.push('## Got it / Lost per 5 minutes', '');
      if (!report.reactions.length) lines.push('None.', '');
      else {
        lines.push('| Session start | Minutes | 👍 Got it | 🤔 Lost |', '|---|---|---|---|');
        report.reactions.forEach((step) => lines.push(`| ${when(step.sessionOpenedAt)} | ${step.minute}–${step.minute + 5} | ${step.gotIt} | ${step.lost} |`));
        lines.push('');
      }

      lines.push('## Questions posted during the class', '');
      if (!report.questions.length) lines.push('None.', '');
      report.questions.forEach((question) => {
        lines.push(`- ${question.hidden ? '(hidden) ' : ''}${question.question} (▲ ${question.votes}${question.replies ? `, ${question.replies} replies` : ''}${question.discussed ? ', discussed' : ''})`);
      });
      lines.push('');
      return lines.join('\n');
    };

    const renderReports = () => {
      const firstStart = new Map();
      liveSessions.forEach((entry) => {
        const key = entry.context_key;
        const start = entry.opened_at;
        if (!firstStart.has(key) || start < firstStart.get(key)) firstStart.set(key, start);
      });
      const contexts = [...firstStart.entries()].sort((a, b) => (a[1] < b[1] ? 1 : -1));
      const body = document.querySelector('#admin-reports-body');
      body.replaceChildren();
      document.querySelector('#admin-reports-count').textContent = `${contexts.length} class${contexts.length === 1 ? '' : 'es'}`;
      document.querySelector('#admin-reports-empty').hidden = contexts.length > 0;
      document.querySelector('#admin-reports-wrap').hidden = contexts.length === 0;
      contexts.forEach(([contextKey, start]) => {
        const row = document.createElement('tr');
        const actions = document.createElement('td');
        // Rehearsals and tests: wipe this class's data so it never mixes with the real class.
        const reset = document.createElement('button');
        reset.type = 'button';
        reset.className = 'admin-remove';
        reset.textContent = 'Delete test data';
        reset.addEventListener('click', async () => {
          if (!window.confirm(`Delete all votes, feedback and Got it / Lost for ${sessionLabel(contextKey)}? This cannot be undone. Classroom questions are kept.`)) return;
          try {
            await requestAdmin('admin_reset_class', { context_key: contextKey });
            await loadOverview('Test data deleted.');
          } catch (error) {
            dashboardStatus.textContent = error instanceof Error ? error.message : 'Could not delete the data.';
          }
        });
        [['Report (.md)', 'md'], ['Data (.json)', 'json']].forEach(([label, format]) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'admin-toggle';
          button.textContent = label;
          button.addEventListener('click', async () => {
            try {
              const result = await requestAdmin('admin_class_report', { context_key: contextKey });
              if (format === 'md') download(`${contextKey}.md`, reportMarkdown(result.report), 'text/markdown');
              else download(`${contextKey}.json`, JSON.stringify(result.report, null, 2), 'application/json');
            } catch (error) {
              dashboardStatus.textContent = error instanceof Error ? error.message : 'Could not make the report.';
            }
          });
          actions.append(button);
        });
        actions.append(reset);
        row.append(createCell(sessionLabel(contextKey)), createCell(formatDate(start)), actions);
        body.append(row);
      });
    };

    const renderOverview = (overview, message = '') => {
      const years = Array.isArray(overview?.years) ? overview.years : [];
      renderYears(years);
      renderBoards(Array.isArray(overview?.boards) ? overview.boards : [], years);
      renderLegacyFeedback(Array.isArray(overview?.feedback) ? overview.feedback : []);
      renderFeedback();
      renderLikes(Array.isArray(overview?.reactions) ? overview.reactions : []);
      renderReports();
      renderQuestions(Array.isArray(overview?.questions) ? overview.questions : []);
      renderReplies(Array.isArray(overview?.replies) ? overview.replies : []);
      dashboardStatus.textContent = message;
    };

    const loadOverview = async (message = '') => {
      dashboardStatus.textContent = 'Loading records…';
      const [result] = await Promise.all([
        requestAdmin('admin_overview', { year_key: yearFilter.value || null }),
        loadLiveSessions(),
      ]);
      await loadFeedback();
      renderOverview(result.overview, message);
    };

    loginForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const password = new FormData(loginForm).get('password');
      const button = loginForm.querySelector('button');
      button.disabled = true;
      loginStatus.textContent = 'Checking password…';
      try {
        const response = await fetch(submissionUrl, {
          method: 'POST',
          headers: { apikey: publishableKey, 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'admin_login', password: String(password ?? '') }),
        });
        if (!response.ok) throw new Error(await readError(response, 'Could not sign in.'));
        const result = await response.json();
        if (typeof result?.token !== 'string') throw new Error('Could not start an admin session.');
        sessionStorage.setItem(tokenStorageKey, result.token);
        loginPanel.hidden = true;
        dashboard.hidden = false;
        loginForm.reset();
        await loadOverview();
      } catch (error) {
        loginStatus.textContent = error instanceof Error ? error.message : 'Could not sign in.';
      } finally {
        button.disabled = false;
      }
    });

    yearForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const yearLabel = yearInput.value.trim();
      dashboardStatus.textContent = 'Adding academic-year option…';
      try {
        await requestAdmin('admin_create_year', { year_key: yearLabel });
        yearInput.value = '';
        await loadOverview('Academic-year option added to the student selector.');
      } catch (error) {
        dashboardStatus.textContent = error instanceof Error ? error.message : 'Could not add the academic-year option.';
      }
    });

    boardForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const contextKey = `${boardYear.value}-classroom`;
      boardStatus.textContent = 'Starting question board…';
      try {
        await requestAdmin('admin_open_question_board', { context_key: contextKey });
        await loadOverview('Question board is live.');
        boardStatus.textContent = 'Question board is live.';
      } catch (error) {
        boardStatus.textContent = error instanceof Error ? error.message : 'Could not start the question board.';
      }
    });

    archiveBoard.addEventListener('click', async () => {
      const liveRow = [...boardsList.querySelectorAll('.admin-board-row.is-live')][0];
      if (!liveRow) return;
      const liveBoard = liveRow.querySelector('strong')?.textContent;
      const boards = await requestAdmin('admin_overview', { year_key: null });
      const live = Array.isArray(boards?.overview?.boards)
        ? boards.overview.boards.find((board) => board.status === 'live') : null;
      if (!live) return;
      if (!window.confirm(`Archive ${liveBoard || 'the live board'}? Students will only be able to read it.`)) return;
      boardStatus.textContent = 'Archiving question board…';
      try {
        await requestAdmin('admin_archive_question_board', { context_key: live.contextKey });
        await loadOverview('Question board archived.');
        boardStatus.textContent = 'Question board archived.';
      } catch (error) {
        boardStatus.textContent = error instanceof Error ? error.message : 'Could not archive the question board.';
      }
    });

    yearFilter.addEventListener('change', () => {
      loadOverview().catch((error) => {
        dashboardStatus.textContent = error instanceof Error ? error.message : 'Could not load records.';
      });
    });

    if (getToken()) {
      loginPanel.hidden = true;
      dashboard.hidden = false;
      loadOverview().catch(() => clearSession());
    }
  </script>
</SiteLayout>
