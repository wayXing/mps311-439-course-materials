---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { course, type CourseLesson } from '../../data/course';
import { withBase } from '../../lib/urls';
import ResourceCard from '../../components/ResourceCard.astro';
import ResourceIcon from '../../components/ResourceIcon.astro';

export function getStaticPaths() {
  return course.lessons.map((lesson, index) => ({
    params: { slug: lesson.slug },
    props: {
      lesson,
      previousLesson: course.lessons[index - 1] ?? null,
      nextLesson: course.lessons[index + 1] ?? null,
    },
  }));
}

interface Props {
  lesson: CourseLesson;
  previousLesson: CourseLesson | null;
  nextLesson: CourseLesson | null;
}

const { lesson, previousLesson, nextLesson } = Astro.props;
// Keep printable files in the source archive, but do not list them on the website.
// Same order as the home page chips (Slides, Notes, … Lab, Colab, Solution); other kinds keep their place.
const kindOrder = ['guide', 'slides', 'notes', 'notebook', 'worksheet', 'workbook', 'solution'];
const rank = (kind: string) => (kindOrder.includes(kind) ? kindOrder.indexOf(kind) : kindOrder.length);
const visibleResources = lesson.resources
  .filter((resource) => resource.kind !== 'pdf')
  .map((resource, index) => ({ resource, index }))
  .sort((left, right) => rank(left.resource.kind) - rank(right.resource.kind) || left.index - right.index)
  .map(({ resource }) => resource);
// Current materials first (Lecture, Practice, …); last year's files fold away at the bottom.
const mainGroups = [...new Set(visibleResources.map((resource) => resource.group))].filter((group) => group !== 'Archive');
const resourcesIn = (group: string) => visibleResources.filter((resource) => resource.group === group);
const archive = resourcesIn('Archive');
const primaryResource = visibleResources.find((resource) => resource.kind === 'slides')
  ?? visibleResources.find((resource) => resource.kind === 'guide');
// The heading uses the same short title as the home page; the longer title becomes a subtitle.
const subtitle = lesson.title !== lesson.shortTitle ? lesson.title : null;
---

<SiteLayout
  title={`${lesson.label}: ${lesson.shortTitle} · ${course.code}`}
  description={lesson.summary}
>
  <section class={`detail-hero shell accent-${lesson.accent}`}>
    <a class="back-link" href={`${withBase()}#lessons`}><span aria-hidden="true">←</span> All course lessons</a>

    <div class="detail-hero-grid">
      <div class="detail-copy">
        <span class="eyebrow">{lesson.label} · {course.academicYear}</span>
        <h1>{lesson.shortTitle}</h1>
        {subtitle && <p class="detail-subtitle">{subtitle}</p>}
        <p>{lesson.summary}</p>
        {primaryResource && (
          <a class="button button-primary" href={withBase(primaryResource.href)}>
            <ResourceIcon kind={primaryResource.kind} size={15} />
            {primaryResource.kind === 'slides' ? 'Open slides' : 'Open guide'}
            <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>

      <aside class="topic-panel" aria-labelledby="topics-heading">
        <span class="topic-number" aria-hidden="true">{lesson.number}</span>
        <h2 id="topics-heading">This lesson</h2>
        <ul>
          {lesson.topics.map((topic) => <li>{topic}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section class="resource-section shell" aria-labelledby="materials-heading">
    {lesson.revisionNote && <aside class="note-panel"><strong>What changed</strong><p>{lesson.revisionNote}</p></aside>}

    <div class="section-heading detail-heading">
      <h2 id="materials-heading">Materials</h2>
      <p>Everything for this lesson, collected in one place.</p>
    </div>

    {mainGroups.length > 0 ? mainGroups.map((group) => (
      <section class="resource-group" aria-labelledby={`group-${group.toLowerCase()}`}>
        <div class="resource-group-heading">
          <h3 id={`group-${group.toLowerCase()}`}>{group}</h3>
        </div>
        <div class="resource-grid">
          {resourcesIn(group).map((resource) => <ResourceCard resource={resource} />)}
          {group === 'Lecture' && lesson.video && (
            <div class="resource-card resource-video">
              <a class="resource-card-main" href="#video">
                <span class="resource-icon resource-video"><ResourceIcon kind="video" size={17} /></span>
                <span class="resource-card-copy">
                  <strong>Video</strong>
                  <small>The whole lesson in about {lesson.video.minutes} minutes, with subtitles and chapters. Plays below.</small>
                </span>
              </a>
              <div class="resource-actions"></div>
            </div>
          )}
        </div>
        {group === 'Practice' && resourcesIn(group).some((resource) => resource.kind === 'solution') && (
          <p class="resource-group-note">Try the lab yourself first, then open the solution to compare approaches and check your results.</p>
        )}
      </section>
    )) : (
      <div class="empty-state">
        <span class="empty-orb" aria-hidden="true"></span>
        <h3>Pause, review, connect.</h3>
        <p>No new lecture or lab is scheduled. Use this time to consolidate earlier material.</p>
      </div>
    )}

    {lesson.video && (
      <section class="resource-group" id="video" aria-labelledby="group-video">
        <div class="resource-group-heading">
          <h3 id="group-video">Video</h3>
          <span>About {lesson.video.minutes} min</span>
        </div>
        <div class="lesson-video">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${lesson.video.youtubeId}?rel=0${course.videoPlaylist ? `&list=${course.videoPlaylist}` : ''}`}
            title={`${lesson.label} video: ${lesson.shortTitle}`}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>
        <p class="lesson-video-caption">
          Missed the class, or want to see it again? The whole lesson in about {lesson.video.minutes} minutes, with subtitles and chapters.
          {course.videoPlaylist && <a href={`https://www.youtube.com/playlist?list=${course.videoPlaylist}`} target="_blank" rel="noopener">All lesson videos on YouTube ↗</a>}
        </p>
      </section>
    )}

    {lesson.note && <aside class="note-panel"><strong>Good to know</strong><p>{lesson.note}</p></aside>}

    {archive.length > 0 && (
      <details class="resource-group resource-archive">
        <summary class="resource-group-heading">
          <h3>Previous year (UoS 2025)</h3>
          <span class="archive-toggle">Show {archive.length} files</span>
        </summary>
        <div class="resource-grid">
          {archive.map((resource) => <ResourceCard resource={resource} />)}
        </div>
      </details>
    )}

    <nav class="lesson-navigation" aria-label="Previous and next course lessons">
      {previousLesson
        ? <a href={withBase(`course/${previousLesson.slug}/`)}><span>Previous</span><strong>← {previousLesson.shortTitle}</strong></a>
        : <span></span>}
      {nextLesson
        ? <a class="next" href={withBase(`course/${nextLesson.slug}/`)}><span>Next</span><strong>{nextLesson.shortTitle} →</strong></a>
        : <span></span>}
    </nav>
  </section>
</SiteLayout>
