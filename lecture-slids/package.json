  },
  "dependencies": {
    "@slidev/cli": "52.8.0",
    "@slidev/theme-default": "0.25.0",
    "@slidev/theme-seriph": "0.25.0",
    "slidev-theme-academic": "2.1.0",
    "vue": "3.5.24"
  },
  "devDependencies": {
    "cross-env": "10.1.0",
    "playwright-chromium": "1.56.1",
    "vite-plugin-singlefile": "2.3.0"
  }
}
