{
  "name": "slidev",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "slidev build",
    "build:standalone": "cross-env BUILD_AIO=true slidev build",
    "build:course": "node scripts/build-course-materials.mjs",
    "check:course": "node scripts/check-course-materials.mjs",
    "dev": "slidev --open",
